{% extends 'frontoffice/base.html.twig' %}

{% block title %}Set New Password{% endblock %}

{% block stylesheets %}
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: linear-gradient(135deg, #f7f1df 0%, #d6ecf5 100%);
      font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
    }
    .auth-shell {
      width: 100%;
      max-width: 480px;
      background: #fff;
      border-radius: 18px;
      box-shadow: 0 18px 40px rgba(28, 39, 48, 0.16);
      padding: 30px;
    }
    .auth-title { margin: 0 0 6px; font-size: 30px; font-weight: 800; }
    .auth-subtitle { margin: 0 0 24px; color: #617584; font-size: 14px; }
    .field { margin-bottom: 14px; }
    .label { display: block; margin-bottom: 7px; font-weight: 700; font-size: 14px; }
    .input { width: 100%; border: 1px solid #c6d7df; border-radius: 10px; padding: 11px 12px; font-size: 15px; }
    .btn { border: 0; border-radius: 10px; padding: 10px 16px; font-weight: 700; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
    .btn-primary { background: #0f6d8a; color: #fff; }
    .btn-secondary { background: #e9f1f4; color: #1c2730; }
    .auth-actions { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
    .notice { background: rgba(15, 109, 138, 0.08); border: 1px solid rgba(15, 109, 138, 0.18); color: #0a4c61; border-radius: 12px; padding: 12px; margin-bottom: 16px; }
    .error { color: #cc334b; font-size: 13px; margin-top: 6px; }
  </style>
{% endblock %}

{% block body %}
  <div class="auth-shell">
    <h1 class="auth-title">Set a new password</h1>
    <p class="auth-subtitle">Choose a strong password for your account.</p>

    {% for message in app.flashes('success') %}
      <div class="notice">{{ message }}</div>
    {% endfor %}

    {% if error %}
      <div class="notice" style="background: rgba(204, 51, 75, 0.08); border-color: rgba(204, 51, 75, 0.18); color:#a1263d;">{{ error }}</div>
    {% endif %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
      <div class="field">
        {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'label'}}) }}
        {{ form_widget(form.plainPassword, {'attr': {'class': 'input'}}) }}
        <div class="error">{{ form_errors(form.plainPassword) }}</div>
      </div>
      <div class="field">
        {{ form_label(form.plainPasswordConfirm, null, {'label_attr': {'class': 'label'}}) }}
        {{ form_widget(form.plainPasswordConfirm, {'attr': {'class': 'input'}}) }}
        <div class="error">{{ form_errors(form.plainPasswordConfirm) }}</div>
      </div>
      <div class="auth-actions">
        <button class="btn btn-primary" type="submit">Update password</button>
        <a class="btn btn-secondary" href="{{ path('app_login') }}">Back to login</a>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
