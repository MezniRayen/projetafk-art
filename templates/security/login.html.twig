{% extends 'frontoffice/base.html.twig' %}

{% block title %}Login{% endblock %}

{% block stylesheets %}
  <style>
    :root {
      --auth-bg-1: #f7f1df;
      --auth-bg-2: #d6ecf5;
      --auth-accent: #0f6d8a;
      --auth-accent-dark: #0a4c61;
      --auth-card: #ffffff;
      --auth-text: #1c2730;
      --auth-muted: #617584;
      --auth-danger: #cc334b;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
      color: var(--auth-text);
      background:
        radial-gradient(circle at 20% 20%, rgba(15, 109, 138, 0.18), transparent 40%),
        radial-gradient(circle at 80% 10%, rgba(204, 51, 75, 0.12), transparent 35%),
        linear-gradient(160deg, var(--auth-bg-1), var(--auth-bg-2));
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .auth-shell {
      width: 100%;
      max-width: 480px;
      background: var(--auth-card);
      border-radius: 18px;
      box-shadow: 0 18px 40px rgba(28, 39, 48, 0.16);
      padding: 30px;
    }

    .auth-title {
      margin: 0 0 6px;
      font-size: 30px;
      line-height: 1.1;
      font-weight: 800;
      letter-spacing: 0.2px;
    }

    .auth-subtitle {
      margin: 0 0 24px;
      color: var(--auth-muted);
      font-size: 14px;
    }

    .auth-alert {
      background: rgba(204, 51, 75, 0.1);
      color: var(--auth-danger);
      border: 1px solid rgba(204, 51, 75, 0.22);
      border-radius: 12px;
      padding: 10px 12px;
      font-size: 14px;
      margin-bottom: 16px;
    }

    .field {
      margin-bottom: 14px;
    }

    .label {
      display: block;
      margin-bottom: 7px;
      font-weight: 700;
      font-size: 14px;
    }

    .input {
      width: 100%;
      border: 1px solid #c6d7df;
      border-radius: 10px;
      padding: 11px 12px;
      font-size: 15px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .input:focus {
      outline: none;
      border-color: var(--auth-accent);
      box-shadow: 0 0 0 3px rgba(15, 109, 138, 0.15);
    }

    .auth-actions {
      display: flex;
      gap: 10px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .btn {
      border: 0;
      border-radius: 10px;
      padding: 10px 16px;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .btn-primary {
      background: var(--auth-accent);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--auth-accent-dark);
    }

    .btn-secondary {
      background: #e9f1f4;
      color: var(--auth-text);
    }

    .btn-secondary:hover {
      background: #dbe8ed;
    }
  </style>
{% endblock %}

{% block body %}
<div class="auth-shell">
  <h1 class="auth-title">Welcome Back</h1>
  <p class="auth-subtitle">Sign in to continue to your workspace.</p>

  {% if error %}
    <div class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
  {% endif %}

  <form method="post" novalidate>
    <div class="field">
      <label class="label" for="username">Email</label>
      <input class="input" type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
    </div>

    <div class="field">
      <label class="label" for="password">Password</label>
      <input class="input" type="password" id="password" name="_password" required pattern="^[^<>]+$" title="HTML tags are not allowed.">
    </div>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    <div class="auth-actions">
      <button class="btn btn-primary" type="submit">Sign in</button>
      <a class="btn btn-secondary" href="{{ path('app_register') }}">Create account</a>
    </div>
  </form>
</div>
{% endblock %}
