<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: DejaVu Sans, sans-serif; font-size: 12px; }
    h1 { font-size: 18px; margin-bottom: 10px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #bbb; padding: 6px; text-align: left; }
    th { background: #efefef; }
  </style>
</head>
<body>
  <h1>{{ title }}</h1>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Artist</th>
        <th>Goal</th>
        <th>Collected</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for project in items %}
        <tr>
          <td>{{ project.id }}</td>
          <td>{{ project.titre }}</td>
          <td>{{ project.artiste ? project.artiste.displayName : 'N/A' }}</td>
          <td>{{ project.objectifFinancier }}</td>
          <td>{{ project.montantCollecte }}</td>
          <td>{{ project.statut }}</td>
        </tr>
      {% else %}
        <tr><td colspan="6">No data</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
