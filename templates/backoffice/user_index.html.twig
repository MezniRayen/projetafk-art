{% extends 'backoffice/base.html.twig' %}

{% block title %}Users{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" crossorigin href="{{ asset('backoffice/assets/css/index.css') }}">
{% endblock %}

{% block body %}
<div class="container" style="padding: 24px 0;">
  <h1>Users</h1>
  {% for message in app.flashes('success') %}
    <div class="alert alert-success" role="alert">{{ message }}</div>
  {% endfor %}
  <form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
      <input class="form-control" type="text" name="search" value="{{ search|default('') }}" placeholder="Search by name, email or role">
    </div>
    <div class="col-md-3">
      <select class="form-select" name="sort">
        <option value="id" {{ sort == 'id' ? 'selected' : '' }}>Sort by ID</option>
        <option value="nom" {{ sort == 'nom' ? 'selected' : '' }}>Sort by Last Name</option>
        <option value="prenom" {{ sort == 'prenom' ? 'selected' : '' }}>Sort by First Name</option>
        <option value="email" {{ sort == 'email' ? 'selected' : '' }}>Sort by Email</option>
        <option value="role" {{ sort == 'role' ? 'selected' : '' }}>Sort by Role</option>
        <option value="userType" {{ sort == 'userType' ? 'selected' : '' }}>Sort by Type</option>
        <option value="statut" {{ sort == 'statut' ? 'selected' : '' }}>Sort by Status</option>
      </select>
    </div>
    <div class="col-md-2">
      <select class="form-select" name="dir">
        <option value="DESC" {{ dir == 'DESC' ? 'selected' : '' }}>DESC</option>
        <option value="ASC" {{ dir == 'ASC' ? 'selected' : '' }}>ASC</option>
      </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button class="btn btn-primary" type="submit">Apply</button>
      <a class="btn btn-outline-secondary" href="{{ path('app_backoffice_user_export_pdf', {search: search|default(''), sort: sort|default('id'), dir: dir|default('DESC')}) }}">Export PDF</a>
    </div>
  </form>
  <p>
    <a class="btn btn-primary" href="{{ path('app_backoffice_user_new') }}">Create user</a>
    <a class="btn btn-light" href="{{ path('app_backoffice') }}">Dashboard</a>
  </p>
  <table class="table table-striped">
    <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Type</th><th>Status</th><th></th></tr></thead>
    <tbody>
      {% for user in users %}
        <tr>
          <td>{{ user.id }}</td>
          <td>{{ user.displayName }}</td>
          <td>{{ user.email }}</td>
          <td>{{ user.role }}</td>
          <td>{{ user.userType ?: '-' }}</td>
          <td>
            {% if user.statut == 'BANNI' %}
              <span class="badge bg-danger">Banned</span>
            {% elseif user.statut == 'SUSPENDU' %}
              <span class="badge bg-warning text-dark">Suspended</span>
            {% else %}
              <span class="badge bg-success">Active</span>
            {% endif %}
          </td>
          <td>
            <a class="btn btn-sm btn-warning" href="{{ path('app_backoffice_user_edit', {id: user.id}) }}">Edit</a>
            {% if user.statut == 'BANNI' %}
              <form method="post" action="{{ path('app_backoffice_user_unban', {id: user.id}) }}" style="display:inline-block" onsubmit="return confirm('Unban this user?');">
                <input type="hidden" name="_token" value="{{ csrf_token('unban_user_' ~ user.id) }}">
                <button class="btn btn-sm btn-success">Unban</button>
              </form>
            {% else %}
              <form method="post" action="{{ path('app_backoffice_user_ban', {id: user.id}) }}" style="display:inline-block" onsubmit="return confirm('Ban this user?');">
                <input type="hidden" name="_token" value="{{ csrf_token('ban_user_' ~ user.id) }}">
                <button class="btn btn-sm btn-dark">Ban</button>
              </form>
            {% endif %}
            <form method="post" action="{{ path('app_backoffice_user_delete', {id: user.id}) }}" style="display:inline-block" onsubmit="return confirm('Delete user?');">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="7">No users found.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
