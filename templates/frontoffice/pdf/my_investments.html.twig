<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <style>
    body { font-family: DejaVu Sans, sans-serif; font-size: 12px; }
    h1 { margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ccc; padding: 6px; text-align: left; }
    th { background: #f3f3f3; }
  </style>
</head>
<body>
  <h1>{{ title }}</h1>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Project</th>
        <th>Amount</th>
        <th>Payment</th>
        <th>Status</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      {% for item in items %}
        <tr>
          <td>{{ item.id }}</td>
          <td>{{ item.projet.titre }}</td>
          <td>{{ item.montant }}</td>
          <td>{{ item.moyenPaiement }}</td>
          <td>{{ item.statut }}</td>
          <td>{{ item.dateInvestissement ? item.dateInvestissement|date('Y-m-d H:i') : '' }}</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6">No data.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
