{% extends 'frontoffice/base.html.twig' %}

{% block title %}Projects{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('frontoffice/plugins/bulma/bulma.min.css') }}">
  <link rel="stylesheet" href="{{ asset('frontoffice/plugins/fontawesome/css/all.css') }}">
  <link rel="stylesheet" href="{{ asset('frontoffice/css/style.css') }}">
{% endblock %}

{% block body %}
  {% include 'frontoffice/_navbar.html.twig' %}

  <section class="section">
    <div class="container">
      <h1 class="title is-3">Projects</h1>

      {% for message in app.flashes('success') %}
        <div class="notification is-success">{{ message }}</div>
      {% endfor %}

      <form method="get" class="box" style="margin-bottom:1rem;">
        <div class="columns is-multiline is-variable is-2">
          <div class="column is-5-desktop is-12-tablet">
            <label class="label">Search</label>
            <input class="input" type="text" name="search" value="{{ search|default('') }}" placeholder="Title, category, status, artist...">
          </div>
          <div class="column is-3-desktop is-6-tablet">
            <label class="label">Sort by</label>
            <div class="select is-fullwidth">
              <select name="sort">
                <option value="id" {% if (sort|default('id')) == 'id' %}selected{% endif %}>Newest</option>
                <option value="titre" {% if (sort|default('id')) == 'titre' %}selected{% endif %}>Title</option>
                <option value="categorie" {% if (sort|default('id')) == 'categorie' %}selected{% endif %}>Category</option>
                <option value="statut" {% if (sort|default('id')) == 'statut' %}selected{% endif %}>Status</option>
                <option value="objectifFinancier" {% if (sort|default('id')) == 'objectifFinancier' %}selected{% endif %}>Goal</option>
                <option value="montantCollecte" {% if (sort|default('id')) == 'montantCollecte' %}selected{% endif %}>Collected</option>
              </select>
            </div>
          </div>
          <div class="column is-2-desktop is-6-tablet">
            <label class="label">Direction</label>
            <div class="select is-fullwidth">
              <select name="dir">
                <option value="DESC" {% if (dir|default('DESC')) == 'DESC' %}selected{% endif %}>DESC</option>
                <option value="ASC" {% if (dir|default('DESC')) == 'ASC' %}selected{% endif %}>ASC</option>
              </select>
            </div>
          </div>
          <div class="column is-2-desktop is-12-tablet" style="display:flex; align-items:flex-end; gap:8px;">
            <button class="button is-link" type="submit">Apply</button>
            <a class="button is-light" href="{{ path('app_front_projects') }}">Reset</a>
          </div>
        </div>
      </form>

      <div style="margin-bottom:1rem;">
        <a class="button is-dark is-small" href="{{ path('app_front_projects_export_pdf', {search: search|default(''), sort: sort|default('id'), dir: dir|default('DESC')}) }}">Export PDF</a>
      </div>

      <div class="columns is-multiline">
        {% for project in projects %}
          <div class="column is-4-desktop is-6-tablet">
            <div class="box">
              <!-- Artist Info -->
              {% if project.artiste %}
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; padding:12px; background:#f5f7f9; border-radius:8px;">
                  {% if project.artiste.profilePicture %}
                    <img src="{{ asset('uploads/profiles/' ~ project.artiste.profilePicture) }}" alt="{{ project.artiste.displayName }}" style="width:40px; height:40px; border-radius:50%; object-fit:cover;">
                  {% else %}
                    <div style="width:40px; height:40px; border-radius:50%; background:#ddd; display:flex; align-items:center; justify-content:center; color:#999; font-weight:700; font-size:12px;">
                      <i class="fas fa-user"></i>
                    </div>
                  {% endif %}
                  <div>
                    <p style="font-weight:600; margin:0; font-size:14px;">{{ project.artiste.displayName }}</p>
                    <p style="color:#666; font-size:12px; margin:2px 0 0 0;">Artist</p>
                  </div>
                </div>
              {% endif %}
              {% if project.image %}
                <figure style="margin-bottom:12px;">
                  <img src="{{ asset('uploads/projects/' ~ project.image) }}" alt="{{ project.titre }}" style="width:100%; height:190px; object-fit:cover; border-radius:8px;">
                </figure>
              {% endif %}
              <h2 class="title is-5">{{ project.titre }}</h2>
              <p class="mb-2">{{ project.description|slice(0, 150) }}{% if project.description|length > 150 %}...{% endif %}</p>
              <p><strong>Goal:</strong> {{ project.objectifFinancier }}</p>
              <p><strong>Collected:</strong> {{ project.montantCollecte }}</p>
              <p><strong>Category:</strong> {{ project.categorie }}</p>
              <div class="mt-3" style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                <a class="button is-small is-link" href="{{ path('app_front_project_show', {id: project.id}) }}">View details</a>
                {% if project.id in favoriteIds %}
                  <form method="post" action="{{ path('app_front_project_favorite_remove', {id: project.id}) }}" style="display:inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('favorite_project_remove_' ~ project.id) }}">
                    <button class="button is-small is-warning is-light" type="submit">
                      <i class="fas fa-heart-broken"></i>&nbsp;Remove favorite
                    </button>
                  </form>
                {% else %}
                  <form method="post" action="{{ path('app_front_project_favorite_add', {id: project.id}) }}" style="display:inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('favorite_project_' ~ project.id) }}">
                    <button class="button is-small is-danger is-light" type="submit">
                      <i class="fas fa-heart"></i>&nbsp;Add favorite
                    </button>
                  </form>
                {% endif %}
              </div>
            </div>
          </div>
        {% else %}
          <div class="column is-12"><p>No projects available.</p></div>
        {% endfor %}
      </div>

      {% include 'frontoffice/_recommendations.html.twig' with { recommendations: recommendations } %}

    </div>
  </section>
{% endblock %}
