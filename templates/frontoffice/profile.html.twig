{% extends 'frontoffice/base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('frontoffice/plugins/bulma/bulma.min.css') }}">
  <link rel="stylesheet" href="{{ asset('frontoffice/plugins/fontawesome/css/all.css') }}">
  <link rel="stylesheet" href="{{ asset('frontoffice/css/style.css') }}">
  <style>
    .profile-wrapper {
      max-width: 900px;
      margin: 80px auto 40px;
      padding: 0 20px;
    }

    .profile-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 12px;
      padding: 40px;
      color: white;
      margin-bottom: 30px;
      box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
      text-align: center;
    }

    .profile-avatar-wrapper {
      position: relative;
      width: 140px;
      height: 140px;
      margin: 0 auto 20px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .profile-avatar {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid white;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
      background: rgba(255, 255, 255, 0.1);
    }

    .profile-avatar.placeholder {
      background: rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 14px;
    }

    .profile-header-info h1 {
      font-size: 32px;
      margin: 15px 0 5px 0;
      font-weight: 700;
    }

    .profile-header-info p {
      font-size: 16px;
      opacity: 0.95;
    }

    .profile-content {
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .profile-section {
      padding: 30px;
      border-bottom: 1px solid #f0f0f0;
    }

    .profile-section:last-child {
      border-bottom: none;
    }

    .section-title {
      display: flex;
      align-items: center;
      font-size: 18px;
      font-weight: 700;
      color: #2c2c2c;
      margin-bottom: 25px;
    }

    .section-title i {
      margin-right: 12px;
      color: #667eea;
      font-size: 20px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }

    .form-grid.full {
      grid-template-columns: 1fr;
    }

    @media (max-width: 768px) {
      .form-grid {
        grid-template-columns: 1fr;
      }
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-weight: 600;
      margin-bottom: 8px;
      color: #2c2c2c;
      font-size: 14px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 12px 14px !important;
      border: 1px solid #e0e0e0 !important;
      border-radius: 8px !important;
      font-size: 14px;
      transition: all 0.3s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: #667eea !important;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1) !important;
      outline: none !important;
    }

    .form-error {
      color: #e74c3c;
      font-size: 12px;
      margin-top: 6px;
    }

    .button-group {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 25px;
    }

    .btn-save {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 12px 32px;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .btn-save:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
    }

    .btn-secondary {
      background: #f5f5f5;
      color: #2c2c2c;
      padding: 12px 32px;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
      display: inline-block;
    }

    .btn-secondary:hover {
      background: #ececec;
    }

    .danger-zone {
      background: #fff5f5;
      border: 2px solid #ffe0e0;
      border-radius: 10px;
      padding: 25px;
    }

    .danger-zone-title {
      display: flex;
      align-items: center;
      color: #e74c3c;
      font-weight: 700;
      margin-bottom: 15px;
      font-size: 16px;
    }

    .danger-zone-title i {
      margin-right: 10px;
      font-size: 18px;
    }

    .danger-zone p {
      color: #666;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .btn-danger {
      background: #e74c3c;
      color: white;
      padding: 12px 28px;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-danger:hover {
      background: #c0392b;
    }

    .notification {
      border-radius: 8px;
      margin-bottom: 20px;
      padding: 16px 20px;
      border-left: 4px solid #27ae60;
    }

    .notification.is-success {
      background: #f0fdf4;
      color: #27ae60;
      border-left-color: #27ae60;
    }

    .upload-hint {
      font-size: 12px;
      color: #666;
      margin-top: 6px;
    }
  </style>
{% endblock %}

{% block body %}
  {% include 'frontoffice/_navbar.html.twig' %}

  <div class="profile-wrapper">
    <!-- Header with Avatar -->
    <div class="profile-header">
      <div class="profile-avatar-wrapper">
        {% if app.user and app.user.profilePicture %}
          <img class="profile-avatar" src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}" alt="Profile picture">
        {% else %}
          <div class="profile-avatar placeholder">
            <i class="fas fa-user"></i>
          </div>
        {% endif %}
      </div>
      <div class="profile-header-info">
        <h1>{{ app.user ? app.user.displayName : 'User Profile' }}</h1>
        <p><i class="fas fa-envelope"></i> {{ app.user ? app.user.email : '' }}</p>
      </div>
    </div>

    <!-- Notifications -->
    {% for message in app.flashes('success') %}
      <div class="notification is-success">
        <i class="fas fa-check-circle"></i> {{ message }}
      </div>
    {% endfor %}

    <!-- Content -->
    <div class="profile-content">
      <!-- Edit Profile Section -->
      <div class="profile-section">
        <div class="section-title">
          <i class="fas fa-edit"></i>
          Edit Profile Information
        </div>

        {{ form_start(form, {'attr': {'id': 'profile-form', 'novalidate': 'novalidate'}}) }}

          <!-- Name Row -->
          <div class="form-grid">
            <div class="form-group">
              {{ form_label(form.prenom) }}
              {{ form_widget(form.prenom, {'attr': {'class': 'input'}}) }}
              {% if form.prenom.vars.errors|length > 0 %}
                <div class="form-error">{{ form_errors(form.prenom) }}</div>
              {% endif %}
            </div>
            <div class="form-group">
              {{ form_label(form.nom) }}
              {{ form_widget(form.nom, {'attr': {'class': 'input'}}) }}
              {% if form.nom.vars.errors|length > 0 %}
                <div class="form-error">{{ form_errors(form.nom) }}</div>
              {% endif %}
            </div>
          </div>

          <!-- Email -->
          <div class="form-grid full">
            <div class="form-group">
              {{ form_label(form.email) }}
              {{ form_widget(form.email, {'attr': {'class': 'input'}}) }}
              {% if form.email.vars.errors|length > 0 %}
                <div class="form-error">{{ form_errors(form.email) }}</div>
              {% endif %}
            </div>
          </div>

          <!-- Profile Picture -->
          <div class="form-grid full">
            <div class="form-group">
              {{ form_label(form.profilePictureFile) }}
              {{ form_widget(form.profilePictureFile, {'attr': {'class': 'input'}}) }}
              <p class="upload-hint">Accepted formats: JPG, PNG, WebP, GIF (Max 5MB)</p>
              {% if form.profilePictureFile.vars.errors|length > 0 %}
                <div class="form-error">{{ form_errors(form.profilePictureFile) }}</div>
              {% endif %}
            </div>
          </div>

          <!-- Password -->
          <div class="form-grid full">
            <div class="form-group">
              {{ form_label(form.newPassword) }}
              {{ form_widget(form.newPassword, {'attr': {'class': 'input'}}) }}
              <p class="upload-hint">Leave blank to keep your current password. Minimum 8 characters.</p>
              {% if form.newPassword.vars.errors|length > 0 %}
                <div class="form-error">{{ form_errors(form.newPassword) }}</div>
              {% endif %}
            </div>
          </div>

          <div class="button-group">
            <button class="btn-save" type="submit">
              <i class="fas fa-save"></i> Save changes
            </button>
            <a class="btn-secondary" href="{{ path('app_frontoffice') }}">
              <i class="fas fa-arrow-left"></i> Back to home
            </a>
          </div>

        {{ form_end(form) }}
      </div>

      <!-- Danger Zone Section -->
      <div class="profile-section">
        <div class="danger-zone">
          <div class="danger-zone-title">
            <i class="fas fa-exclamation-triangle"></i>
            Danger Zone
          </div>
          <p>Deleting your account is permanent and cannot be undone. All your data will be lost.</p>
          <form method="post" action="{{ path('app_front_profile_delete') }}" onsubmit="return confirm('Are you absolutely sure? This action cannot be reversed.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_my_account') }}">
            <button class="btn-danger" type="submit">
              <i class="fas fa-trash-alt"></i> Delete my account
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
  document.getElementById('profile-form')?.addEventListener('submit', function (e) {
    const blocked = /<[^>]*>/;
    const fields = this.querySelectorAll('input[type="text"], input[type="password"]');
    for (const field of fields) {
      if (field.value && blocked.test(field.value)) {
        e.preventDefault();
        alert('HTML tags are not allowed.');
        field.focus();
        return;
      }
    }
  });
  </script>
{% endblock %}
