{% extends 'frontoffice/base.html.twig' %}

{% block title %}Invest{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('frontoffice/plugins/bulma/bulma.min.css') }}">
  <link rel="stylesheet" href="{{ asset('frontoffice/plugins/fontawesome/css/all.css') }}">
  <link rel="stylesheet" href="{{ asset('frontoffice/css/style.css') }}">
  <style>
    .form-shell {
      background: #fff;
      border: 1px solid #e7ecef;
      border-radius: 14px;
      padding: 22px;
      box-shadow: 0 10px 26px rgba(22, 34, 45, 0.08);
    }

    .form-shell > div {
      margin-bottom: 12px;
    }

    .form-shell label {
      font-weight: 700;
      margin-bottom: 6px;
      display: block;
    }

    .form-shell input,
    .form-shell textarea,
    .form-shell select {
      width: 100%;
      border: 1px solid #c9d7df;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 14px;
    }

    .form-shell input:focus,
    .form-shell textarea:focus,
    .form-shell select:focus {
      outline: none;
      border-color: #1b7a7a;
      box-shadow: 0 0 0 3px rgba(27, 122, 122, 0.14);
    }

    .form-errors,
    .form-shell ul {
      color: #c62828;
      font-size: 13px;
      font-weight: 700;
      margin-top: 6px;
      padding-left: 18px;
    }

    .form-errors {
      border: 1px solid rgba(198, 40, 40, 0.24);
      background: rgba(198, 40, 40, 0.08);
      border-radius: 10px;
      padding: 8px 12px;
      margin-bottom: 12px;
    }
  </style>
{% endblock %}

{% block body %}
{% include 'frontoffice/_navbar.html.twig' %}
<section class="section">
  <div class="container" style="max-width: 780px;">
    <h1 class="mb-4 title is-4">Invest in {{ project.titre }}</h1>
    {{ form_start(form, {'attr': {'id': 'invest-form', 'novalidate': 'novalidate', 'class': 'form-shell'}}) }}
      {% if form.vars.errors|length > 0 %}
        <div class="form-errors">{{ form_errors(form) }}</div>
      {% endif %}
      {{ form_widget(form) }}
      <div style="margin-top: 16px; display:flex; gap:10px; flex-wrap:wrap;">
        <button class="button is-primary">Confirm investment</button>
        <a class="button is-light" href="{{ path('app_front_project_show', {id: project.id}) }}">Back</a>
      </div>
    {{ form_end(form) }}
  </div>
</section>
<script>
document.getElementById('invest-form')?.addEventListener('submit', function (e) {
  const blocked = /<[^>]*>/;
  const fields = this.querySelectorAll('input[type="text"], textarea');
  for (const field of fields) {
    if (blocked.test(field.value)) {
      e.preventDefault();
      alert('HTML tags are not allowed.');
      field.focus();
      return;
    }
  }
});
</script>
{% endblock %}
