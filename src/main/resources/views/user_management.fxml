<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.hounayda.controllers.UserDashboardController"
            stylesheets="@/css/art-style.css">

    <!-- Barre latérale gauche (sidebar) avec nouvelle couleur -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="15" alignment="TOP_CENTER">
            <padding>
                <Insets top="25" bottom="25" left="15" right="15"/>
            </padding>

            <!-- Logo / Titre -->
            <Label text="AFK'Art" styleClass="sidebar-title"/>

            <!-- Infos utilisateur -->
            <VBox spacing="8" alignment="CENTER" styleClass="user-info-card">
                <Label text="👤" style="-fx-font-size: 40px; -fx-text-fill: #4A3B2F;"/>
                <Label fx:id="welcomeLabel" styleClass="user-name"/>
                <Label fx:id="userTypeLabel" styleClass="user-role" text="Utilisateur"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Menu principal -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button text="🏠 Accueil"
                        onAction="#goToDashboard"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <Button text="🎨 Actions Artistiques"
                        onAction="#goToArtisticActions"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <!-- Bouton dynamique (change selon le type) -->
                <Button fx:id="dynamicButton"
                        text="⭐ Définir mon rôle"
                        onAction="#handleDynamicButton"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <!-- Bouton Financement (visible seulement pour "LES_DEUX") -->
                <Button fx:id="financementButton"
                        text="💰 Financement"
                        onAction="#goToInvestissement"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"
                        visible="false" managed="false"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Actions utilisateur -->
            <VBox spacing="5">
                <Button text="👤 Mon Profil"
                        onAction="#openProfile"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <Button text="⚙️ Définir mon rôle"
                        fx:id="btnSetRoleType"
                        onAction="#showRoleTypeDialog"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <Button text="🚪 Déconnexion"
                        onAction="#logout"
                        styleClass="nav-button logout"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>
            </VBox>
        </VBox>
    </left>

    <!-- Contenu central -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Contenu par défaut (page d'accueil utilisateur) -->
            <VBox spacing="25" alignment="TOP_CENTER">
                <!-- Message de bienvenue -->
                <VBox spacing="10" alignment="CENTER">
                    <Label text="Bienvenue sur AFK'Art" styleClass="welcome-title"/>
                    <Label text="Découvrez et participez aux actions artistiques" styleClass="welcome-subtitle"/>
                </VBox>

                <!-- Actions récentes -->
                <VBox spacing="15" styleClass="recent-section">
                    <Label text="Actions récentes" styleClass="section-title"/>
                    <ListView fx:id="recentActionsList" prefHeight="200" styleClass="recent-list"/>
                </VBox>

                <!-- Bouton Voir les actions -->
                <Button text="Voir toutes les actions"
                        onAction="#goToWorks"
                        styleClass="primary-button"
                        maxWidth="200"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>