<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.hounayda.controllers.ResetPasswordController"
      spacing="20"
      alignment="CENTER"
      stylesheets="@/css/art-style.css">

    <padding>
        <Insets top="80" right="50" bottom="80" left="50"/>
    </padding>

    <Label text="Réinitialisation du mot de passe" styleClass="header-title"/>

    <VBox spacing="15" styleClass="card" prefWidth="450">

        <!-- Étape 1: Demande de reset -->
        <VBox fx:id="step1Box" spacing="15">
            <Label text="Étape 1 : Entrez votre email" style="-fx-font-weight: bold; -fx-text-fill: #4A3B2F;"/>

            <TextField fx:id="emailField" promptText="Votre adresse email"/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Envoyer le code" onAction="#requestReset" styleClass="primary-button" prefWidth="150"/>
                <Button text="Retour" onAction="#goToLogin" styleClass="secondary-button" prefWidth="100"/>
            </HBox>

            <Label fx:id="requestStatus" text="" style="-fx-text-fill: #E38792;"/>
        </VBox>

        <!-- Étape 2: Saisie du code -->
        <VBox fx:id="step2Box" spacing="15" visible="false" managed="false">
            <Label text="Étape 2 : Entrez le code reçu" style="-fx-font-weight: bold; -fx-text-fill: #4A3B2F;"/>

            <Label fx:id="codeSentInfo" text="Un code a été envoyé à votre email" style="-fx-text-fill: #666;"/>

            <TextField fx:id="codeField" promptText="Code à 6 chiffres"/>

            <Button text="Vérifier le code" onAction="#verifyCode" styleClass="primary-button" prefWidth="150"/>

            <Label fx:id="codeStatus" text="" style="-fx-text-fill: #E38792;"/>
        </VBox>

        <!-- Étape 3: Nouveau mot de passe -->
        <VBox fx:id="step3Box" spacing="15" visible="false" managed="false">
            <Label text="Étape 3 : Nouveau mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #4A3B2F;"/>

            <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe"/>

            <Button text="Réinitialiser" onAction="#resetPassword" styleClass="primary-button" prefWidth="150"/>

            <Label fx:id="resetStatus" text="" style="-fx-text-fill: #E38792;"/>
        </VBox>

        <!-- Message de succès final -->
        <Label fx:id="successMessage" text="" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" visible="false"/>

    </VBox>

</VBox>