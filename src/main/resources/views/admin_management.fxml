<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.hounayda.controllers.AdminDashboardController"
            stylesheets="@/css/art-style.css">

    <!-- Barre latérale gauche (sidebar) avec les mêmes couleurs -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="15" alignment="TOP_CENTER">
            <padding>
                <Insets top="25" bottom="25" left="15" right="15"/>
            </padding>

            <!-- Logo / Titre -->
            <Label text="AFK'Art Admin" styleClass="sidebar-title"/>

            <!-- Infos administrateur -->
            <VBox spacing="8" alignment="CENTER" styleClass="user-info-card">
                <Label text="👤" style="-fx-font-size: 40px; -fx-text-fill: #4A3B2F;"/>
                <Label fx:id="welcomeLabel" styleClass="user-name"/>
                <Label text="Administrateur" styleClass="user-role"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Menu principal admin -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button text="🏠 Accueil Admin"
                        onAction="#goToDashboard"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <Button text="👥 Gestion Utilisateurs"
                        onAction="#goToUsers"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <Button text="📋 Gestion Actions"
                        onAction="#goToActions"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <Button text="📊 Statistiques"
                        onAction="#goToStats"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Actions utilisateur -->
            <VBox spacing="5">
                <Button text="👤 Mon Profil"
                        onAction="#openProfile"
                        styleClass="nav-button"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>

                <Button text="🚪 Déconnexion"
                        onAction="#logout"
                        styleClass="nav-button logout"
                        prefWidth="220"
                        alignment="CENTER_LEFT"/>
            </VBox>
        </VBox>
    </left>

    <!-- Contenu central dynamique -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Contenu par défaut (page d'accueil admin) -->
            <VBox spacing="25" alignment="TOP_CENTER">
                <!-- Message de bienvenue -->
                <VBox spacing="10" alignment="CENTER">
                    <Label text="Dashboard Administrateur" styleClass="welcome-title"/>
                    <Label text="Gérez les utilisateurs et les actions artistiques" styleClass="welcome-subtitle"/>
                </VBox>

                <!-- Statistiques rapides -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                        <Label text="👥" style="-fx-font-size: 30px;"/>
                        <Label text="Utilisateurs" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 20px; -fx-text-fill: #D16F7F;"/>
                    </VBox>

                    <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                        <Label text="📋" style="-fx-font-size: 30px;"/>
                        <Label text="Actions" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalActionsLabel" text="0" style="-fx-font-size: 20px; -fx-text-fill: #D16F7F;"/>
                    </VBox>

                    <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                        <Label text="✅" style="-fx-font-size: 30px;"/>
                        <Label text="Actives" style="-fx-font-weight: bold;"/>
                        <Label fx:id="activeActionsLabel" text="0" style="-fx-font-size: 20px; -fx-text-fill: #D16F7F;"/>
                    </VBox>
                </HBox>

                <!-- Actions récentes -->
                <VBox spacing="15" styleClass="recent-section">
                    <Label text="Actions récentes" styleClass="section-title"/>
                    <ListView fx:id="recentActionsList" prefHeight="150" styleClass="recent-list"/>
                </VBox>

                <!-- Boutons d'action rapide -->
                <HBox spacing="15" alignment="CENTER">
                    <Button text="➕ Liste Utilisateurs"
                            onAction="#gotoNewUser"
                            styleClass="primary-button"/>
                    <Button text="➕ Nouvelle Action"
                            onAction="#goToActions"
                            styleClass="primary-button"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>